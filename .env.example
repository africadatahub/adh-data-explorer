# Copy to .env in the repo root. Loaded by python-dotenv before Flask config.
# Production still uses platform env vars + scoda/config/production.cfg.
# Package path "scoda" is leftover from the fork; this app is Data Explorer.

FLASK_ENV=development

SECRET_KEY=secret

# SQLAlchemy 1.3 still accepts the postgres:// scheme used in this repo.
DATABASE_URL=postgres://scoda:scoda@localhost/data-explorer

REDIS_URL=redis://localhost:6379

SENTRY_ENV=development
SENTRY_SAMPLER=1
SENTRY_DSN=
